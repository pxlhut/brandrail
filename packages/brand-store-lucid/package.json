{
  "name": "@pxlhut/brand-store-lucid",
  "version": "0.1.1",
  "description": "AdonisJS (Lucid ORM) adapter for @pxlhut/brand-store.",
  "license": "MIT",
  "author": {
    "name": "Misbahur Rahman",
    "url": "https://www.misbahurbd.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pxlhut/brandrail.git",
    "directory": "packages/brand-store-lucid"
  },
  "homepage": "https://github.com/pxlhut/brandrail/tree/main/packages/brand-store-lucid#readme",
  "bugs": "https://github.com/pxlhut/brandrail/issues",
  "keywords": [
    "design-tokens",
    "theming",
    "white-label",
    "multi-tenant",
    "adonisjs",
    "lucid",
    "postgres"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./provider": {
      "import": {
        "types": "./dist/provider.d.ts",
        "default": "./dist/provider.js"
      },
      "require": {
        "types": "./dist/provider.d.cts",
        "default": "./dist/provider.cjs"
      }
    },
    "./models": {
      "import": {
        "types": "./dist/models.d.ts",
        "default": "./dist/models.js"
      },
      "require": {
        "types": "./dist/models.d.cts",
        "default": "./dist/models.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@adonisjs/lucid": "^22.4.2",
    "@pxlhut/brand-core": "workspace:*",
    "luxon": "^3.7.2",
    "pg": "^8.23.0"
  },
  "peerDependencies": {
    "@adonisjs/core": "^7.5.0",
    "@pxlhut/brand-store": "workspace:^"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@adonisjs/core": "^7.5.0",
    "@types/pg": "^8.23.1"
  }
}
