{
  "name": "@pxlhut/brand-store",
  "version": "0.1.1",
  "description": "The persistence contract for brand themes: draft, publish, immutable snapshot, rollback. Zero database dependency — bring your own.",
  "license": "MIT",
  "author": {
    "name": "Misbahur Rahman",
    "url": "https://www.misbahurbd.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pxlhut/brandrail.git",
    "directory": "packages/brand-store"
  },
  "homepage": "https://github.com/pxlhut/brandrail/tree/main/packages/brand-store#readme",
  "bugs": "https://github.com/pxlhut/brandrail/issues",
  "keywords": [
    "design-tokens",
    "theming",
    "white-label",
    "multi-tenant",
    "database-agnostic",
    "orm-agnostic",
    "postgres"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./conformance": {
      "import": {
        "types": "./dist/conformance.d.ts",
        "default": "./dist/conformance.js"
      },
      "require": {
        "types": "./dist/conformance.d.cts",
        "default": "./dist/conformance.cjs"
      }
    },
    "./memory": {
      "import": {
        "types": "./dist/memory.d.ts",
        "default": "./dist/memory.js"
      },
      "require": {
        "types": "./dist/memory.d.cts",
        "default": "./dist/memory.cjs"
      }
    },
    "./service": {
      "import": {
        "types": "./dist/service.d.ts",
        "default": "./dist/service.js"
      },
      "require": {
        "types": "./dist/service.d.cts",
        "default": "./dist/service.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src/contract/rules.md",
    "src/service/features/delivery/read-path.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@pxlhut/brand-core": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^26.5.1"
  }
}
