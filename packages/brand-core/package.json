{
  "name": "@pxlhut/brand-core",
  "version": "0.1.1",
  "description": "Generate a complete, gamut-mapped, APCA-validated design token tree from one brand colour. Pure, browser-safe, framework-agnostic.",
  "license": "MIT",
  "author": {
    "name": "Misbahur Rahman",
    "url": "https://www.misbahurbd.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pxlhut/brandrail.git",
    "directory": "packages/brand-core"
  },
  "homepage": "https://github.com/pxlhut/brandrail/tree/main/packages/brand-core#readme",
  "bugs": "https://github.com/pxlhut/brandrail/issues",
  "keywords": [
    "design-tokens",
    "theming",
    "white-label",
    "multi-tenant",
    "oklch",
    "apca",
    "accessibility",
    "wcag",
    "color",
    "shadcn"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.proofs.json"
  },
  "dependencies": {
    "apca-w3": "^0.1.9",
    "culori": "^4.0.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/culori": "^4.0.1",
    "@types/node": "^26.5.1",
    "fast-check": "^4.10.0",
    "jsdom": "^30.0.1"
  }
}
