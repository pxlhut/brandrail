{
  "name": "@pxlhut/brand-editor",
  "version": "0.1.0",
  "description": "Headless React state for a brand settings screen that reshapes itself from the platform's control config.",
  "license": "MIT",
  "author": {
    "name": "Misbahur Rahman",
    "url": "https://www.misbahurbd.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pxlhut/brandrail.git",
    "directory": "packages/brand-editor"
  },
  "homepage": "https://github.com/pxlhut/brandrail/tree/main/packages/brand-editor#readme",
  "bugs": "https://github.com/pxlhut/brandrail/issues",
  "keywords": [
    "design-tokens",
    "theming",
    "white-label",
    "multi-tenant",
    "react",
    "shadcn",
    "shadcn-registry"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "registry.json",
    "registry/brand-editor",
    "!registry/brand-editor/**/*.test.tsx"
  ],
  "scripts": {
    "build": "tsup && shadcn build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p registry/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@pxlhut/brand-core": "workspace:*",
    "@pxlhut/brand-store": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@base-ui/react": "^1.8.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "jsdom": "^30.0.1",
    "lucide-react": "^1.45.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.0"
  }
}
