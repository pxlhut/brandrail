{
  "name": "brandrail",
  "private": true,
  "description": "Multi-tenant brand theming for platforms that white-label — one hex in, an APCA-validated design-token tree out, with a per-field control-tier model the platform vendor owns.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pxlhut/brandrail.git"
  },
  "homepage": "https://github.com/pxlhut/brandrail#readme",
  "bugs": "https://github.com/pxlhut/brandrail/issues",
  "license": "MIT",
  "author": {
    "name": "Misbahur Rahman",
    "url": "https://www.misbahurbd.com"
  },
  "type": "module",
  "packageManager": "pnpm@12.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "arch": "depcruise packages --config .dependency-cruiser.cjs",
    "purity": "node scripts/check-core-purity.mjs",
    "size": "node scripts/check-bundle-size.mjs",
    "verify": "pnpm build && pnpm typecheck && pnpm lint && pnpm arch && pnpm test && pnpm size && pnpm purity",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@eslint/js": "^9.38.0",
    "dependency-cruiser": "^17.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.38.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "^3.2.4"
  }
}
